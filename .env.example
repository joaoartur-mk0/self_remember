# cmd/api
SELF_REMEMBER_HTTP_ADDR=:8080
SELF_REMEMBER_LOG_LEVEL=info

# obrigatório, sem default: string de conexão com o Postgres. O host
# "localhost" vale para um binário local; sob docker-compose.local.yml (api e
# worker na mesma rede do compose), troque para "postgres" — o nome do
# serviço.
SELF_REMEMBER_DATABASE_URL=postgres://self_remember:senha@localhost:5432/self_remember?sslmode=disable

# obrigatório, sem default: segredo de assinatura dos JWT de acesso
SELF_REMEMBER_JWT_SECRET=troque-por-um-segredo-aleatorio-de-verdade

# cmd/api e cmd/worker — Canal de e-mail (SMTP), credencial de instância
# (ADR-0001). Nenhuma delas tem default: sem SMTP, o Canal que "não pode
# falhar" não sobe, e a API também não (envia código de verificação de
# Canal pelo mesmo Canal).
SELF_REMEMBER_SMTP_HOST=smtp.exemplo.com
SELF_REMEMBER_SMTP_PORT=587
SELF_REMEMBER_SMTP_USERNAME=troque-por-um-usuario-de-verdade
SELF_REMEMBER_SMTP_PASSWORD=troque-por-uma-senha-de-verdade
SELF_REMEMBER_SMTP_FROM=self-remember@exemplo.com

# cmd/api e cmd/worker — Canal de WhatsApp (EvolutionAPI), credencial de
# instância (ADR-0005). A API usa a mesma credencial para verificar Canais e
# para o painel de status/QR code da instância.
# BASE_URL já é container-to-container (nome do serviço "evolution" no
# docker-compose.local.yml). API_KEY tem um valor fixo de dev porque
# precisa ser exatamente o mesmo configurado no serviço "evolution" abaixo —
# em produção, os dois viram segredos de verdade, nunca este valor.
SELF_REMEMBER_EVOLUTION_BASE_URL=http://evolution:8080
SELF_REMEMBER_EVOLUTION_API_KEY=dev-local-evolution-key
SELF_REMEMBER_EVOLUTION_INSTANCE=self-remember
# teto de mensagens por minuto por instância (ADR-0005); default 20 se omitido
SELF_REMEMBER_EVOLUTION_MAX_MESSAGES_PER_MINUTE=20

# opcional: destino do alerta de sessão do WhatsApp desconectada (ADR-0005).
# Vazio desativa o alerta sem impedir o boot do worker.
SELF_REMEMBER_OPS_EMAIL=
