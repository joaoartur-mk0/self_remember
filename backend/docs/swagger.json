{
    "swagger": "2.0",
    "info": {
        "description": "API do Self Remember. Local/dev apenas: /swagger não é exposto em produção sem Traefik/auth na frente (ARCHITECTURE.md §9, fase de Produção ainda não implementada).",
        "title": "Self Remember API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/areas": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "areas"
                ],
                "summary": "Listar Áreas",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/http.areaResponse"
                            }
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "areas"
                ],
                "summary": "Criar Área",
                "parameters": [
                    {
                        "description": "Nome e cor (opcional) da Área",
                        "name": "area",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.createAreaRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/http.areaResponse"
                        }
                    },
                    "400": {
                        "description": "Corpo da requisição inválido"
                    },
                    "409": {
                        "description": "Já existe uma Área com este nome"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "description": "Autentica por e-mail e senha e grava os cookies de sessão (access_token e refresh_token).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Login",
                "parameters": [
                    {
                        "description": "E-mail e senha",
                        "name": "credentials",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.loginRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Login bem-sucedido; cookies de sessão gravados"
                    },
                    "400": {
                        "description": "Corpo da requisição inválido"
                    },
                    "401": {
                        "description": "Credenciais inválidas"
                    }
                }
            }
        },
        "/auth/refresh": {
            "post": {
                "description": "Rotaciona o refresh token do cookie e grava uma nova sessão. Reusar um token já rotacionado revoga todas as sessões ativas do usuário (ADR-0008).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Refresh",
                "responses": {
                    "204": {
                        "description": "Sessão renovada; novos cookies gravados"
                    },
                    "401": {
                        "description": "Refresh token ausente, expirado, revogado ou já reusado"
                    }
                }
            }
        },
        "/labels": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "labels"
                ],
                "summary": "Listar Etiquetas",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/http.labelResponse"
                            }
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "labels"
                ],
                "summary": "Criar Etiqueta",
                "parameters": [
                    {
                        "description": "Nome da Etiqueta",
                        "name": "label",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.createLabelRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/http.labelResponse"
                        }
                    },
                    "400": {
                        "description": "Corpo da requisição inválido"
                    },
                    "409": {
                        "description": "Já existe uma Etiqueta com este nome"
                    }
                }
            }
        }
    },
    "definitions": {
        "http.areaResponse": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "http.createAreaRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "color": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "http.createLabelRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string"
                }
            }
        },
        "http.labelResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "http.loginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        }
    }
}